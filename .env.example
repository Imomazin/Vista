# VisTa production readiness — configure only in Vercel secure environment settings.
# Never commit actual secret values, OAuth refresh tokens or service-account JSON.
# Supabase must be configured before organisation-scoped provider tests are enabled.
VISTA_SUPABASE_URL=
VISTA_SUPABASE_ANON_KEY=
# Used only by the scheduled sampling worker; not sent to the browser.
VISTA_SUPABASE_SERVICE_ROLE_KEY=
# Add this exact service account email as a verified user on GSC and Viewer on GA4.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON service-account RSA private key PEM. Keep multiline key secret in Vercel.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Example: sc-domain:example.com OR https://www.example.com/
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Numeric property ID, not measurement ID (G-...).
GOOGLE_ANALYTICS_PROPERTY_ID=
# HubSpot private app with crm.objects.contacts.read and crm.objects.deals.read
HUBSPOT_PRIVATE_APP_TOKEN=
# OpenAI responses API key, with sufficient API credit and approved project.
OPENAI_API_KEY=
OPENAI_SAMPLING_MODEL=gpt-4.1-mini
# Vercel Cron adds Authorization: Bearer <CRON_SECRET>. Random 32+ chars.
CRON_SECRET=
# Exact authorised org UUID. Prompts encoded as JSON string array, max 3.
VISTA_AI_SAMPLING_ORGANISATION_ID=
VISTA_AI_SAMPLING_BRAND=Ambidexters
VISTA_AI_SAMPLING_PROMPTS=
# Optional hardened distributed rate limiting for public/provider requests.
VISTA_RATE_LIMIT_URL=
VISTA_RATE_LIMIT_TOKEN=
VISTA_RATE_LIMIT_SALT=
# Optional Google PageSpeed Insights API key for Lighthouse lab and CrUX field data (higher quota).
PAGESPEED_API_KEY=
# Crawler resource policy (defaults shown). Limits are per document; transfer = bytes on the wire, decoded = after decompression.
VISTA_CRAWL_MAX_HTML_MB=10
VISTA_CRAWL_MAX_TRANSFER_MB=15
VISTA_CRAWL_MAX_DECODED_MB=60
VISTA_CRAWL_MAX_COMPRESSION_RATIO=120
VISTA_CRAWL_TIMEOUT_MS=15000
VISTA_CRAWL_RETRIES=1
# Optional Browserless-compatible rendering service (POST {endpoint}/content) for JavaScript-dependent pages.
VISTA_RENDER_ENDPOINT=
VISTA_RENDER_TOKEN=
# Optional page ceilings per audit tier (Enterprise is available to signed-in members only).
NEXT_PUBLIC_VISTA_MAX_PAGES_QUICK=25
NEXT_PUBLIC_VISTA_MAX_PAGES_DEEP=250
NEXT_PUBLIC_VISTA_MAX_PAGES_ENTERPRISE=5000
# Intelligent Discovery: AI-assisted research (public | members | off), its daily deployment budget and model.
VISTA_DISCOVERY_AI=public
VISTA_DISCOVERY_DAILY_AI_CALLS=400
OPENAI_DISCOVERY_MODEL=
# Optional search data providers (nothing is estimated without them):
# DataForSEO: search volume, CPC, competition, keyword difficulty, live Google rankings and organic competitors.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Brave Search API: live web results (organic competitors and rankings) only.
BRAVE_SEARCH_API_KEY=
# TEST ONLY — never set in production (ignored on Vercel): simulated OpenAI endpoint from scripts/intel-fixtures.mjs.
VISTA_TEST_OPENAI_URL=
# TEST ONLY — never set in production (ignored on Vercel): comma-separated http fixture origins the crawler may contact.
VISTA_TEST_CRAWL_ORIGINS=
