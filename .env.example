# VisTa production readiness — configure only in Vercel secure environment settings.
# Never commit actual secret values, OAuth refresh tokens or service-account JSON.
# Supabase must be configured before organisation-scoped provider tests are enabled.
VISTA_SUPABASE_URL=
VISTA_SUPABASE_ANON_KEY=
# Used only by the scheduled sampling worker; not sent to the browser.
VISTA_SUPABASE_SERVICE_ROLE_KEY=
# Add this exact service account email as a verified user on GSC and Viewer on GA4.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON service-account RSA private key PEM. Keep multiline key secret in Vercel.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Example: sc-domain:example.com OR https://www.example.com/
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Numeric property ID, not measurement ID (G-...).
GOOGLE_ANALYTICS_PROPERTY_ID=
# HubSpot private app with crm.objects.contacts.read and crm.objects.deals.read
HUBSPOT_PRIVATE_APP_TOKEN=
# OpenAI responses API key, with sufficient API credit and approved project.
OPENAI_API_KEY=
OPENAI_SAMPLING_MODEL=gpt-4.1-mini
# Vercel Cron adds Authorization: Bearer <CRON_SECRET>. Random 32+ chars.
CRON_SECRET=
# Exact authorised org UUID. Prompts encoded as JSON string array, max 3.
VISTA_AI_SAMPLING_ORGANISATION_ID=
VISTA_AI_SAMPLING_BRAND=Ambidexters
VISTA_AI_SAMPLING_PROMPTS=
# Optional hardened distributed rate limiting for public/provider requests.
VISTA_RATE_LIMIT_URL=
VISTA_RATE_LIMIT_TOKEN=
VISTA_RATE_LIMIT_SALT=
